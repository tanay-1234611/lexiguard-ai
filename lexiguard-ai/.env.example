# ---------- AWS Bedrock (all AI reasoning) ----------
# Region where you enabled model access, e.g. us-east-1
AWS_REGION=
# Optional if you use the AWS default credential chain (aws configure, SSO, IAM role, ...)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary credentials
AWS_SESSION_TOKEN=
# A model or inference-profile ID that YOUR account can invoke (see README, "Choose a model")
BEDROCK_MODEL_ID=

# ---------- HeyKoala Voice API (outbound voice calls) ----------
# API key from HeyKoala: Settings -> API Keys. Looks like hk_api_...
HEYKOALA_API_KEY=
# Development is the default. Use https://voice.heykoala.ai/api/v1/ext for production.
HEYKOALA_BASE_URL=https://dvoice.heykoala.ai/api/v1/ext
# Optional. Defaults to your first active agent / number if left empty.
HEYKOALA_AGENT_ID=
HEYKOALA_FROM_NUMBER=
HEYKOALA_KNOWLEDGE_BASE_ID=
HEYKOALA_CALL_FLOW_ID=
# Optional. Only set if you have a public URL that can receive HeyKoala webhooks.
HEYKOALA_EVENT_WEBHOOK_URL=

# ---------- App ----------
# "true" keeps analyzed contracts on local disk in .data/ (off by default: memory only)
PERSIST_CONTRACTS=false
